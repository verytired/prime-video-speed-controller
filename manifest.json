{
  "manifest_version": 3,
  "name": "Prime Video Speed Controller",
  "version": "1.0.0",
  "description": "Amazon Prime Videoの再生速度を自由に変更できる拡張機能。",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["*://www.amazon.co.jp/gp/video/detail/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.amazon.co.jp/gp/video/detail/*"],
      "js": ["content.js"]
    }
  ]
}

